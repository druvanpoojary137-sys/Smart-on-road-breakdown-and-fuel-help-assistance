<!DOCTYPE html>

<html lang="en">

<head>

```
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Vehicle Breakdown Assistance</title>
```

</head>

<body>

```
<h1>🚗 Vehicle Breakdown Assistance</h1>


<!-- ============================= -->
<!-- LOGIN -->
<!-- ============================= -->

<section>

    <h2>User Login</h2>

    <p id="loginStatus">
        Checking login...
    </p>

    <button
        type="button"
        onclick="goToLogin()">

        Login

    </button>

</section>


<hr>


<!-- ============================= -->
<!-- PROBLEM -->
<!-- ============================= -->

<section>

    <h2>Describe Your Vehicle Problem</h2>

    <textarea
        id="problem"
        rows="5"
        cols="50"
        placeholder="Example: My bike tyre is flat">

    </textarea>

    <br><br>

    <button
        type="button"
        onclick="checkProblem()">

        Check Problem

    </button>

</section>


<hr>


<!-- ============================= -->
<!-- LOCATION -->
<!-- ============================= -->

<section>

    <h2>Your Location</h2>

    <button
        type="button"
        onclick="getLocation()">

        Get My Location

    </button>

    <p id="locationStatus">
        Location not detected
    </p>

    <p>
        Latitude:
        <span id="latitude">-</span>
    </p>

    <p>
        Longitude:
        <span id="longitude">-</span>
    </p>

</section>


<hr>


<!-- ============================= -->
<!-- CATEGORY -->
<!-- ============================= -->

<section
    id="categorySection"
    style="display:none;">

    <h2>Problem Category</h2>

    <p id="category"></p>

</section>


<hr>


<!-- ============================= -->
<!-- HELPERS -->
<!-- ============================= -->

<section
    id="helpersSection"
    style="display:none;">

    <h2>Available Helpers</h2>

    <div id="helpers">

        Searching for helpers...

    </div>

</section>


<hr>


<!-- ============================= -->
<!-- REQUEST STATUS -->
<!-- ============================= -->

<section
    id="statusSection"
    style="display:none;">

    <h2>Assistance Request Status</h2>

    <p id="requestStatus">
        Checking request status...
    </p>

</section>
```

<script>


// ========================================
// VARIABLES
// ========================================

let userLatitude = null;

let userLongitude = null;

let detectedCategory = null;

let requestSent = false;



// ========================================
// LOGIN CHECK
// ========================================

function checkLogin() {

    fetch("/current-user")

        .then(response => response.json())

        .then(data => {

            const loginStatus =
                document.getElementById("loginStatus");


            if (data.loggedIn) {

                loginStatus.innerText =
                    "Logged in as: "
                    + data.user.name
                    + " ("
                    + data.user.phone
                    + ")";

            }

            else {

                loginStatus.innerText =
                    "You are not logged in.";

            }

        })

        .catch(error => {

            console.log(
                "Login check error:",
                error
            );

        });

}



// ========================================
// GO TO LOGIN
// ========================================

function goToLogin() {

    window.location.href = "/login";

}



// ========================================
// GET LOCATION
// ========================================

function getLocation() {

    const locationStatus =
        document.getElementById(
            "locationStatus"
        );


    if (!navigator.geolocation) {

        locationStatus.innerText =
            "Geolocation is not supported.";

        return;

    }


    locationStatus.innerText =
        "Detecting location...";


    navigator.geolocation.getCurrentPosition(

        function(position) {

            userLatitude =
                position.coords.latitude;

            userLongitude =
                position.coords.longitude;


            document.getElementById(
                "latitude"
            ).innerText =
                userLatitude;


            document.getElementById(
                "longitude"
            ).innerText =
                userLongitude;


            locationStatus.innerText =
                "Location detected successfully.";


            // Send location to backend

            fetch("/location", {

                method: "POST",

                headers: {

                    "Content-Type":
                        "application/json"

                },

                body: JSON.stringify({

                    latitude:
                        userLatitude,

                    longitude:
                        userLongitude

                })

            })

            .then(response =>
                response.json()
            )

            .then(data => {

                console.log(
                    "Location saved:",
                    data
                );

            })

            .catch(error => {

                console.log(
                    "Location save error:",
                    error
                );

            });

        },


        function(error) {

            console.log(
                "Location error:",
                error
            );


            locationStatus.innerText =
                "Unable to detect location.";

        }

    );

}



// ========================================
// CHECK PROBLEM
// ========================================

function checkProblem() {

    const problem =
        document.getElementById(
            "problem"
        ).value.trim();


    if (!problem) {

        alert(
            "Please describe your vehicle problem."
        );

        return;

    }


    if (
        userLatitude === null ||
        userLongitude === null
    ) {

        alert(
            "Please get your location first."
        );

        return;

    }


    // Hide old results

    document.getElementById(
        "categorySection"
    ).style.display = "none";


    document.getElementById(
        "helpersSection"
    ).style.display = "none";


    document.getElementById(
        "statusSection"
    ).style.display = "none";


    document.getElementById(
        "category"
    ).innerText =
        "Detecting...";


    // Send problem to NLP

    fetch("/predict", {

        method: "POST",

        headers: {

            "Content-Type":
                "application/json"

        },

        body: JSON.stringify({

            problem: problem

        })

    })

    .then(async response => {

        const data =
            await response.json();


        if (!response.ok) {

            throw new Error(
                data.message ||
                "Prediction failed."
            );

        }


        return data;

    })

    .then(data => {

        detectedCategory =
            data.category;


        document.getElementById(
            "category"
        ).innerText =
            detectedCategory;


        document.getElementById(
            "categorySection"
        ).style.display = "block";


        // Find suitable helpers

        findHelpers();

    })

    .catch(error => {

        console.log(
            "Prediction error:",
            error
        );


        alert(
            error.message ||
            "Unable to detect problem."
        );

    });

}



// ========================================
// FIND HELPERS
// ========================================

function findHelpers() {

    if (!detectedCategory) {

        return;

    }


    if (
        userLatitude === null ||
        userLongitude === null
    ) {

        return;

    }


    const helpersDiv =
        document.getElementById(
            "helpers"
        );


    helpersDiv.innerHTML =
        "<p>Searching for nearby helpers...</p>";


    document.getElementById(
        "helpersSection"
    ).style.display = "block";


    fetch("/find-helper", {

        method: "POST",

        headers: {

            "Content-Type":
                "application/json"

        },

        body: JSON.stringify({

            category:
                detectedCategory,

            latitude:
                userLatitude,

            longitude:
                userLongitude

        })

    })

    .then(async response => {

        const data =
            await response.json();


        console.log(
            "Find helper response:",
            data
        );


        if (!response.ok) {

            throw new Error(

                data.message ||
                data.error ||
                "Error finding helpers."

            );

        }


        return data;

    })

    .then(data => {

        helpersDiv.innerHTML = "";


        // Make sure backend returned an array

        if (!Array.isArray(data)) {

            helpersDiv.innerHTML =

                "<p>Error finding helpers.</p>";

            console.log(
                "Expected array but received:",
                data
            );

            return;

        }


        // No helpers

        if (data.length === 0) {

            helpersDiv.innerHTML =

                "<p>No available helpers found.</p>";

            return;

        }


        // Display helpers

        data.forEach(function(helper) {

            const helperDiv =
                document.createElement("div");


            const distance =
                Number(helper.distance);


            helperDiv.innerHTML = `

                <hr>

                <h3>
                    ${helper.name}
                </h3>

                <p>
                    <strong>Service:</strong>
                    ${helper.service}
                </p>

                <p>
                    <strong>Phone:</strong>
                    ${helper.phone}
                </p>

                <p>
                    <strong>Distance:</strong>
                    ${
                        Number.isFinite(distance)
                        ? distance.toFixed(2)
                        : "Unknown"
                    }
                    km
                </p>

                <br>

                <a
                    href="tel:${helper.phone}">

                    <button type="button">
                        📞 Call Helper
                    </button>

                </a>

                <button
                    type="button"
                    onclick="requestAssistance('${helper.phone}')">

                    Request Assistance

                </button>

            `;


            helpersDiv.appendChild(
                helperDiv
            );

        });

    })

    .catch(error => {

        console.log(
            "FIND HELPER ERROR:",
            error
        );


        helpersDiv.innerHTML =

            "<p>" +
            error.message +
            "</p>";

    });

}



// ========================================
// REQUEST ASSISTANCE
// ========================================

function requestAssistance(helperPhone) {

    const problem =
        document.getElementById(
            "problem"
        ).value.trim();


    if (!problem) {

        alert(
            "Please describe your problem."
        );

        return;

    }


    if (!detectedCategory) {

        alert(
            "Problem category not detected."
        );

        return;

    }


    if (
        userLatitude === null ||
        userLongitude === null
    ) {

        alert(
            "Location is required."
        );

        return;

    }


    if (requestSent) {

        alert(
            "Request already sent."
        );

        return;

    }


    fetch("/request-helper", {

        method: "POST",

        headers: {

            "Content-Type":
                "application/json"

        },

        body: JSON.stringify({

            helperPhone:
                helperPhone,

            problem:
                problem,

            category:
                detectedCategory,

            latitude:
                userLatitude,

            longitude:
                userLongitude

        })

    })

    .then(async response => {

        const data =
            await response.json();


        if (!response.ok) {

            throw new Error(

                data.message ||
                "Failed to send request."

            );

        }


        return data;

    })

    .then(data => {

        requestSent = true;


        document.getElementById(
            "statusSection"
        ).style.display = "block";


        document.getElementById(
            "requestStatus"
        ).innerText =

            data.message ||
            "Assistance request sent.";


        // Start checking status

        checkRequestStatus();

    })

    .catch(error => {

        console.log(
            "Request error:",
            error
        );


        alert(
            error.message ||
            "Failed to send assistance request."
        );

    });

}



// ========================================
// CHECK REQUEST STATUS
// ========================================

function checkRequestStatus() {

    fetch("/request-status")

        .then(async response => {

            const data =
                await response.json();


            if (!response.ok) {

                throw new Error(

                    data.message ||
                    "Unable to check request status."

                );

            }


            return data;

        })

        .then(data => {

            if (!data.found) {

                document.getElementById(
                    "requestStatus"
                ).innerText =
                    "Waiting for request...";

                return;

            }


            const request =
                data.request;


            if (!request) {

                return;

            }


            if (
                request.status ===
                "PENDING"
            ) {

                document.getElementById(
                    "requestStatus"
                ).innerText =
                    "⏳ Request sent. Waiting for helper to accept.";

            }


            else if (
                request.status ===
                "ACCEPTED"
            ) {

                document.getElementById(
                    "requestStatus"
                ).innerText =

                    "✅ Helper accepted your request.\n"
                    +
                    "Helper: "
                    +
                    (
                        request.helperName ||
                        "Helper"
                    )
                    +
                    "\nPhone: "
                    +
                    (
                        request.helperPhone ||
                        ""
                    );


                // Stop repeated requests

                return;

            }


            else if (
                request.status ===
                "REJECTED"
            ) {

                document.getElementById(
                    "requestStatus"
                ).innerText =
                    "❌ Helper rejected the request.";

            }

        })

        .catch(error => {

            console.log(
                "Status error:",
                error
            );

        });

}



// ========================================
// START LOGIN CHECK
// ========================================

checkLogin();

</script>

</body>

</html>
