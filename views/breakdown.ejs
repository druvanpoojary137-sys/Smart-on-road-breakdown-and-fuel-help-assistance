<!DOCTYPE html>
<html>

<head>

    <title>Vehicle Breakdown Assistance</title>

</head>

<body>

    <h1>
        Vehicle Breakdown Assistance
    </h1>

    <p id="userInfo">
        Checking login...
    </p>

    <hr>

    <h2>Describe Your Problem</h2>

    <textarea
        id="problem"
        rows="5"
        cols="50"
        placeholder="Example: My bike tire is flat"
    ></textarea>

    <br><br>

    <button id="findButton">
        Find Helper
    </button>

    <p id="locationStatus">
        Getting location...
    </p>

    <p id="category"></p>

    <hr>

    <h2>Nearby Helpers</h2>

    <div id="helpers">
        No helpers found yet.
    </div>

    <hr>

    <h2>Request Status</h2>

    <div id="requestStatus">
        No active request.
    </div>

    <br>

    <button
        onclick="window.location.href='/logout'"
    >
        Logout
    </button>


    <script>

        let latitude = null;
        let longitude = null;

        let currentRequestId = null;

        let statusInterval = null;


        // ==========================
        // CHECK USER LOGIN
        // ==========================

        async function checkUser() {

            try {

                const response =
                    await fetch("/current-user");

                const data =
                    await response.json();

                if (
                    !data.loggedIn ||
                    data.role !== "user"
                ) {

                    window.location.href =
                        "/login";

                    return;
                }

                document
                    .getElementById("userInfo")
                    .textContent =
                    "Logged in as: " +
                    data.name +
                    " | " +
                    data.phone;

            } catch (error) {

                console.error(error);

            }

        }


        // ==========================
        // GET LOCATION
        // ==========================

        function getLocation() {

            if (!navigator.geolocation) {

                document
                    .getElementById("locationStatus")
                    .textContent =
                    "Geolocation is not supported.";

                return;
            }

            navigator.geolocation.getCurrentPosition(

                async function(position) {

                    latitude =
                        position.coords.latitude;

                    longitude =
                        position.coords.longitude;

                    document
                        .getElementById("locationStatus")
                        .textContent =
                        "Location detected.";

                    await fetch(
                        "/location",
                        {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({
                                    latitude:
                                        latitude,
                                    longitude:
                                        longitude
                                })

                        }
                    );

                },

                function(error) {

                    console.error(error);

                    document
                        .getElementById("locationStatus")
                        .textContent =
                        "Unable to get location.";

                }
            );

        }


        // ==========================
        // FIND HELPERS
        // ==========================

        document
            .getElementById("findButton")
            .addEventListener(
                "click",
                findHelpers
            );


        async function findHelpers() {

            const problem =
                document
                    .getElementById("problem")
                    .value
                    .trim();

            if (!problem) {

                alert(
                    "Please enter your problem."
                );

                return;
            }

            if (
                latitude === null ||
                longitude === null
            ) {

                alert(
                    "Location is not available yet."
                );

                return;
            }


            // --------------------------
            // PREDICT CATEGORY
            // --------------------------

            document
                .getElementById("category")
                .textContent =
                "Predicting problem...";

            try {

                const predictResponse =
                    await fetch(
                        "/predict",
                        {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({
                                    problem:
                                        problem
                                })

                        }
                    );

                const predictData =
                    await predictResponse.json();

                if (!predictData.success) {

                    alert(
                        predictData.message
                    );

                    return;
                }

                const category =
                    predictData.category;

                document
                    .getElementById("category")
                    .textContent =
                    "Predicted Category: " +
                    category;


                // --------------------------
                // FIND HELPERS
                // --------------------------

                document
                    .getElementById("helpers")
                    .innerHTML =
                    "Finding nearby helpers...";


                const helperResponse =
                    await fetch(
                        "/find-helper",
                        {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({

                                    category:
                                        category,

                                    latitude:
                                        latitude,

                                    longitude:
                                        longitude

                                })

                        }
                    );

                const helperData =
                    await helperResponse.json();

                if (!helperData.success) {

                    document
                        .getElementById("helpers")
                        .textContent =
                        helperData.message;

                    return;
                }

                const helpers =
                    helperData.helpers;

                if (
                    !helpers ||
                    helpers.length === 0
                ) {

                    document
                        .getElementById("helpers")
                        .innerHTML =
                        "<p>No nearby helpers available.</p>";

                    return;
                }


                // --------------------------
                // DISPLAY HELPERS
                // --------------------------

                let html = "";

                helpers.forEach(
                    function(helper) {

                        html += `

                            <div
                                style="
                                    border:1px solid #ccc;
                                    padding:15px;
                                    margin:10px 0;
                                "
                            >

                                <h3>
                                    ${helper.name}
                                </h3>

                                <p>
                                    Service:
                                    ${helper.service}
                                </p>

                                <p>
                                    Phone:
                                    ${helper.phone}
                                </p>

                                <p>
                                    Distance:
                                    ${helper.distance}
                                    km
                                </p>

                                <a
                                    href="tel:${helper.phone}"
                                >
                                    <button>
                                        Call
                                    </button>
                                </a>

                                <button
                                    onclick="
                                        requestHelper(
                                            '${helper.phone}',
                                            '${escapeText(problem)}',
                                            '${category}'
                                        )
                                    "
                                >
                                    Request Assistance
                                </button>

                            </div>

                        `;
                    }
                );

                document
                    .getElementById("helpers")
                    .innerHTML = html;

            } catch (error) {

                console.error(error);

                alert(
                    "Something went wrong."
                );

            }

        }


        // ==========================
        // ESCAPE TEXT
        // ==========================

        function escapeText(text) {

            return text
                .replace(/\\/g, "\\\\")
                .replace(/'/g, "\\'")
                .replace(/\n/g, "\\n")
                .replace(/\r/g, "");
        }


        // ==========================
        // REQUEST HELPER
        // ==========================

        async function requestHelper(
            helperPhone,
            problem,
            category
        ) {

            try {

                const response =
                    await fetch(
                        "/request-helper",
                        {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({

                                    helperPhone:
                                        helperPhone,

                                    problem:
                                        problem,

                                    category:
                                        category,

                                    latitude:
                                        latitude,

                                    longitude:
                                        longitude

                                })

                        }
                    );

                const data =
                    await response.json();

                console.log(data);

                if (!data.success) {

                    alert(
                        data.message
                    );

                    return;
                }

                currentRequestId =
                    data.requestId;

                document
                    .getElementById("requestStatus")
                    .innerHTML =
                    `
                        <p>
                            ⏳ Request sent.
                            Waiting for helper...
                        </p>
                    `;

                startStatusChecking();

            } catch (error) {

                console.error(error);

                alert(
                    "Could not send request."
                );

            }

        }


        // ==========================
        // CHECK REQUEST STATUS
        // ==========================

        function startStatusChecking() {

            if (statusInterval) {

                clearInterval(
                    statusInterval
                );
            }

            checkRequestStatus();

            statusInterval =
                setInterval(
                    checkRequestStatus,
                    3000
                );

        }


        async function checkRequestStatus() {

            if (!currentRequestId) {
                return;
            }

            try {

                const response =
                    await fetch(
                        "/request-status?requestId=" +
                        encodeURIComponent(
                            currentRequestId
                        )
                    );

                const data =
                    await response.json();

                if (!data.success) {
                    return;
                }

                if (!data.request) {
                    return;
                }

                const request =
                    data.request;


                // --------------------------
                // PENDING
                // --------------------------

                if (
                    request.status ===
                    "PENDING"
                ) {

                    document
                        .getElementById(
                            "requestStatus"
                        )
                        .innerHTML =
                        `
                            <p>
                                ⏳ Waiting for
                                ${request.helperName}
                                to respond...
                            </p>
                        `;

                }


                // --------------------------
                // ACCEPTED
                // --------------------------

                else if (
                    request.status ===
                    "ACCEPTED"
                ) {

                    document
                        .getElementById(
                            "requestStatus"
                        )
                        .innerHTML =
                        `
                            <h3>
                                ✅ Request Accepted
                            </h3>

                            <p>
                                ${request.helperName}
                                has accepted your
                                assistance request.
                            </p>

                            <p>
                                Phone:
                                ${request.helperPhone}
                            </p>

                            <a
                                href="tel:${request.helperPhone}"
                            >
                                <button>
                                    Call Helper
                                </button>
                            </a>
                        `;

                    clearInterval(
                        statusInterval
                    );

                }


                // --------------------------
                // REJECTED
                // --------------------------

                else if (
                    request.status ===
                    "REJECTED"
                ) {

                    document
                        .getElementById(
                            "requestStatus"
                        )
                        .innerHTML =
                        `
                            <h3>
                                ❌ Request Rejected
                            </h3>

                            <p>
                                ${request.helperName}
                                rejected your request.
                            </p>

                            <p>
                                You can request
                                another helper.
                            </p>
                        `;

                    clearInterval(
                        statusInterval
                    );

                }

            } catch (error) {

                console.error(
                    "STATUS ERROR:",
                    error
                );

            }

        }


        // ==========================
        // START
        // ==========================

        checkUser();

        getLocation();

    </script>

</body>

</html>