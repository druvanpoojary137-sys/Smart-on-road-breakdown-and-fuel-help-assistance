<!DOCTYPE html>
<html>

<head>

    <title>Helper Dashboard</title>

</head>

<body>

    <h1>Helper Dashboard</h1>


    <div id="loginSection">

        <p>
            You are not logged in.
        </p>

        <button onclick="goToLogin()">
            Login
        </button>

    </div>


    <div id="dashboard"
         style="display:none;">

        <h2>Assistance Request</h2>

        <div id="request">
            Checking for requests...
        </div>


        <div id="buttons"
             style="display:none;">

            <button onclick="acceptRequest()">
                Accept
            </button>

            <button onclick="rejectRequest()">
                Reject
            </button>

        </div>


        <p id="status"></p>

    </div>


    <script src="/helper.js"></script>

</body>

</html>